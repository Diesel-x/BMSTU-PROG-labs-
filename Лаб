def display_fields(field_names):
    print("Доступные поля для поиска:")
    for idx, field in enumerate(field_names, 1):
        print(f"{idx}. {field}")

def search_by_field(filename, delimiter='|'):
    data = read_database(filename, delimiter)
    if not data:
        print("База данных пуста.")
        return
    field_names = data[0]
    display_fields(field_names)
    
    while True:
        field_input = input("Введите номер или название поля для поиска: ").strip()
        if field_input.isdigit():
            field_num = int(field_input)
            if 1 <= field_num <= len(field_names):
                field_name = field_names[field_num - 1]
                break
            else:
                print("Номер поля вне диапазона. Попробуйте снова.")
        else:
            if field_input in field_names:
                field_name = field_input
                field_num = field_names.index(field_input) + 1
                break
            else:
                print("Название поля не найдено. Попробуйте снова.")
    
    search_value = input("Введите значение для поиска (подстрока): ").strip().lower()
    found = False
    print("\nНайденные записи:")
    for record in data[1:]:
        if len(record) >= field_num and search_value in record[field_num - 1].lower():
            print(record)
            found = True
    if not found:
        print("Записи не найдены.")

