import os
import struct

RECORD_FORMAT = 'i 20s 20s 20s'  # id (int), фамилия, имя, отчество
RECORD_SIZE = struct.calcsize(RECORD_FORMAT)

def init_database(filename):
    n = int(input("Введите количество записей для инициализации: "))
    with open(filename, 'wb') as f:
        for _ in range(n):
            id = int(input("Введите id (целое число): "))
            last_name = input("Введите фамилию (до 20 символов): ").encode('utf-8')
            first_name = input("Введите имя (до 20 символов): ").encode('utf-8')
            patronymic = input("Введите отчество (до 20 символов): ").encode('utf-8')
            record = struct.pack(RECORD_FORMAT, id, last_name.ljust(20)[:20], first_name.ljust(20)[:20], patronymic.ljust(20)[:20])
            f.write(record)

def print_database(filename):
    if not os.path.exists(filename):
        print("Файл не существует.")
        return
    with open(filename, 'rb') as f:
        index = 1
        while True:
            bytes_read = f.read(RECORD_SIZE)
            if not bytes_read:
                break
            record = struct.unpack(RECORD_FORMAT, bytes_read)
            id = record[0]
            last_name = record[1].decode('utf-8').strip()
            first_name = record[2].decode('utf-8').strip()
            patronymic = record[3].decode('utf-8').strip()
            print(f"{index}. ID: {id}, Фамилия: {last_name}, Имя: {first_name}, Отчество: {patronymic}")
            index += 1

